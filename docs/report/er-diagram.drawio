        <mxCell id="shape62" value="PK 主键  /  FK 外键  /  UQ 单列唯一  /  ? 允许为空  /  1 恰好一个  /  0..1 至多一个  /  0..N 零个到多个" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#233648;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="125" y="1902" width="913.0" height="30" />
        </mxCell>
        <mxCell id="shape63" value="连线两端的数字表示该端记录数。例如：物品 1 — 0..N 交易订单，表示一个物品可保留多次申请或取消的历史订单。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#233648;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="125" y="1940" width="1040.0" height="30" />
        </mxCell>
        <mxCell id="shape64" value="† meeting_day 是仍存在的旧星期字段，只兼容历史记录；当前发布和新订单使用 meeting_date（DATE）。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#233648;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="125" y="1978" width="977.96875" height="30" />
        </mxCell>
        <mxCell id="shape65" value="reputation_records.source_id 是业务来源编号，没有物理外键；备份表不属于业务实体，因此不入图。ENUM 完整取值见字段清单。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#233648;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="125" y="2016" width="1196.46875" height="30" />
        </mxCell>
        <mxCell id="shape66" value="唯一外键决定 0..1：回收预约.item_id、完成记录.recycling_order_id、交易评价.trade_id。可空外键按数据库实际结构标注。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#233648;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="125" y="2054" width="1121.984375" height="30" />
        </mxCell>
