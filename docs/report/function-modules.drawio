<mxfile host="app.diagrams.net"><diagram name="系统功能模块图"><mxGraphModel pageWidth="1900" pageHeight="720"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="root" value="校园闲置物品交易与环保回收管理系统" style="rounded=1;html=1;fillColor=#FF7A1A;fontColor=#FFFFFF;fontSize=23;" vertex="1" parent="1"><mxGeometry as="geometry" x="710" y="100" width="480" height="80" /></mxCell><mxCell id="m0" value="用户与认证&lt;br&gt;&lt;br&gt;注册 · 登录 · 退出&lt;br&gt;会话与角色权限&lt;br&gt;密码哈希 · 请求校验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6EE;strokeColor=#FFC699;fontColor=#253443;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="300" width="230" height="235" /></mxCell><mxCell id="edge0" style="edgeStyle=orthogonalEdgeStyle;endArrow=none;strokeColor=#9AA5B1;" edge="1" parent="1" source="root" target="m0"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="m1" value="物品流转&lt;br&gt;&lt;br&gt;物品发布 · 图片上传&lt;br&gt;关键词与方式查询&lt;br&gt;编辑重审 · 逻辑下架" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6EE;strokeColor=#FFC699;fontColor=#253443;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="305" y="300" width="230" height="235" /></mxCell><mxCell id="edge1" style="edgeStyle=orthogonalEdgeStyle;endArrow=none;strokeColor=#9AA5B1;" edge="1" parent="1" source="root" target="m1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="m2" value="交易订单&lt;br&gt;&lt;br&gt;出售 / 赠送申请&lt;br&gt;卖家确认 · 买家完成&lt;br&gt;撤回订单 · 安排快照" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6EE;strokeColor=#FFC699;fontColor=#253443;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="570" y="300" width="230" height="235" /></mxCell><mxCell id="edge2" style="edgeStyle=orthogonalEdgeStyle;endArrow=none;strokeColor=#9AA5B1;" edge="1" parent="1" source="root" target="m2"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="m3" value="回收管理&lt;br&gt;&lt;br&gt;选择回收点 · 预约&lt;br&gt;时间校验 · 确认处理&lt;br&gt;重量录入 · 完成回收" style="rounded=1;whiteSpace=wrap;ht